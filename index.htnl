<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TRADINGBOTFS</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#070b1e;color:#fff;overflow-x:hidden}
.header{padding:18px 20px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:2}
.logo{display:flex;align-items:center;gap:8px;font-weight:800;color:#f5d56e;letter-spacing:1px}
.logo-icon{width:32px;height:32px;background:#00e676;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#000;font-weight:900}
.menu{width:42px;height:36px;background:linear-gradient(135deg,#7c4dff,#00bcd4);border-radius:8px;display:flex;align-items:center;justify-content:center}
.stars{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}
.star{position:absolute;width:2px;height:2px;background:#fff;border-radius:50%;animation:blink 2.5s infinite}
@keyframes blink{0%,100%{opacity:0.15}50%{opacity:1;box-shadow:0 0 8px #fff,0 0 12px #2ec4ff}}
.hero{position:relative;z-index:2;padding:10px 18px 30px;text-align:center;max-width:600px;margin:0 auto}
.chart-box{position:relative;width:100%;height:230px;background:#0a0f2a;border-radius:16px;overflow:hidden;border:1px solid #1a2450;margin:15px 0}
#tvchart{width:100%;height:100%;position:absolute;top:0;left:0}
.dim{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(7,11,30,0.35);z-index:1}
.sell-buy{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;gap:20px;z-index:2}
.pill{padding:13px 30px;border-radius:30px;font-weight:900;border:none;font-size:14px;display:flex;align-items:center;gap:6px}
.sell-pill{background:#ff3b30;color:#fff;box-shadow:0 4px 18px rgba(255,59,48,0.6)}
.buy-pill{background:#00e676;color:#000;box-shadow:0 4px 18px rgba(0,230,118,0.6)}
.title{margin-top:26px}
.title b{color:#2ec4ff;font-size:22px;display:block}
.title h1{font-size:26px;line-height:1.2;margin:8px 0;font-weight:800}
.subtitle{font-size:15px;font-weight:600;margin:15px 0}
.desc{font-size:14px;color:#cbd5e1;margin:18px 0}
.desc span{color:#2ec4ff}
.auth-btns{display:flex;gap:14px;justify-content:center;margin:24px 0}
.btn-auth{padding:12px 30px;border-radius:25px;font-weight:700;font-size:14px;border:none}
.login-btn{background:linear-gradient(135deg,#7c4dff,#2196f3);color:#fff}
.reg-btn{background:transparent;color:#fff;border:1px solid #7c4dff}
.how{text-align:left;margin-top:10px}
.how h2{font-size:20px;margin-bottom:12px}
.card{background:#0f1733;border:1px solid #1a2450;border-radius:12px;padding:14px;margin:8px 0;font-size:14px}
#chatBtn{position:fixed;bottom:18px;right:18px;width:58px;height:58px;background:#00e676;border-radius:50%;border:none;font-size:24px;z-index:10}
#chatBox{position:fixed;bottom:85px;right:15px;width:320px;height:360px;background:#0f172a;border:1px solid #1e2f4a;border-radius:14px;display:none;flex-direction:column;z-index:10;overflow:hidden}
#chatM{flex:1;padding:10px;overflow:auto;display:flex;flex-direction:column;gap:6px;background:#070b1e}
.msg{padding:8px 10px;border-radius:10px;max-width:80%;font-size:13px} .u{background:#00e676;color:#000;align-self:flex-end} .a{background:#1e2f4a;color:#fff;align-self:flex-start}
#chatIn{display:flex;padding:8px;background:#0f1733;gap:6px}
#chatIn input{flex:1;padding:8px;border-radius:6px;border:1px solid #1e2f4a;background:#070b1e;color:#fff}
</style>
</head>
<body>
<div class="stars" id="stars"></div>

<div class="header">
<div class="logo"><div class="logo-icon">T</div> TRADINGBOTFS</div>
<div class="menu">≡</div>
</div>

<div class="hero">
<div class="chart-box">
<div id="tvchart"></div>
<div class="dim"></div>
<div class="sell-buy">
<button class="pill sell-pill" onclick="alert('SELL executed!')">◷ SELL</button>
<button class="pill buy-pill" onclick="alert('BUY executed!')">◷ BUY</button>
</div>
</div>

<div class="title">
<b>TradingBotFS</b>
<h1>Build your future with Investments.</h1>
</div>

<p class="subtitle">Discover the power of earning in an increasing cryptocurrency ecosystem.</p>

<p class="desc">Check Out The Benefits of Joining and <span>●</span><br><span>●</span> Investing with Us!!</p>

<div class="auth-btns">
<button class="btn-auth login-btn" onclick="document.getElementById('loginBox').style.display='block';document.getElementById('loginBox').scrollIntoView({behavior:'smooth'})">LOGIN</button>
<button class="btn-auth reg-btn" onclick="document.getElementById('loginBox').style.display='block';document.getElementById('loginBox').scrollIntoView({behavior:'smooth'})">REGISTER</button>
</div>

<div id="loginBox" style="display:none;max-width:400px;margin:0 auto;background:#0f1733;border:1px solid #1a2450;border-radius:14px;padding:20px">
<h3 style="text-align:center">Login</h3>
<input id="em" placeholder="Email" style="width:100%;padding:12px;margin:8px 0;background:#070b1e;border:1px solid #1a2450;border-radius:8px;color:#fff">
<input id="pw" type="password" placeholder="Password" style="width:100%;padding:12px;margin:8px 0;background:#070b1e;border:1px solid #1a2450;border-radius:8px;color:#fff">
<button class="btn-auth login-btn" style="width:100%;margin-top:8px" onclick="if(em.value=='Davidjohn70010@gmail.com'&&pw.value=='Admin@12345'){alert('Admin login')}else if(em.value){alert('Welcome $1000 bonus')}">Continue</button>
</div>

<div class="how">
<h2>How It Works</h2>
<div class="card">• Create Account - Register in 20 sec</div>
<div class="card">• Activate AI Bot - Bot trades 24/7</div>
<div class="card">• Withdraw Profit - Daily profit, min $10</div>
</div>
</div>

<button id="chatBtn" onclick="chatBox.style.display=chatBox.style.display=='flex'?'none':'flex'">💬</button>
<div id="chatBox">
<div style="padding:12px;background:#0f1733;display:flex;justify-content:space-between"><b>Support</b><span onclick="chatBox.style.display='none'" style="cursor:pointer">✕</span></div>
<div id="chatM"><div class="msg a">Hello! Welcome to TRADINGBOTFS 👋</div></div>
<div id="chatIn"><input id="chatT" placeholder="Message..."><button onclick="let v=chatT.value;if(!v)return;let d=document.createElement('div');d.className='msg u';d.textContent=v;chatM.appendChild(d);chatT.value='';chatM.scrollTop=9999;setTimeout(()=>{let r=document.createElement('div');r.className='msg a';r.textContent='Admin will reply soon ✅';chatM.appendChild(r);chatM.scrollTop=9999},600)" style="background:#00e676;border:none;padding:8px 12px;border-radius:6px;font-weight:700">Send</button></div>
</div>

<script src="https://s3.tradingview.com/tv.js"></script>
<script>
new TradingView.widget({"autosize":true,"symbol":"BINANCE:BTCUSDT","interval":"1","timezone":"Etc/UTC","theme":"dark","style":"1","locale":"en","container_id":"tvchart"});
let sDiv=document.getElementById('stars');
for(let i=0;i<80;i++){let s=document.createElement('div');s.className='star';s.style.left=Math.random()*100+'%';s.style.top=Math.random()*100+'%';s.style.animationDelay=(Math.random()*3)+'s';s.style.animationDuration=(1.5+Math.random()*3)+'s';sDiv.appendChild(s)}
</script>
</body>
</html>
